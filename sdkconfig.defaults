CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# hg::App runs on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# wss:// endpoints are verified against the bundled CA certificates.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# The core plus Wi-Fi and TLS outgrow the default 1 MB app partition. Replace
# with a two-slot OTA table once OTA is ported.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
